{
  "manifest_version": 3,
  "name": "Novel Box - Đọc chương trên trình duyệt",
  "version": "1.1.0",
  "description": "Đọc danh sách và văn bản chương công khai đã hiển thị trên Gia Tộc Vượng Tài.",
  "permissions": [
    "tabs",
    "scripting"
  ],
  "host_permissions": [
    "https://giatocvuongtai.com/*",
    "https://*.giatocvuongtai.com/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "https://yuu110299.github.io/NovelBox/*"
      ],
      "js": [
        "bridge.js"
      ],
      "run_at": "document_start"
    }
  ]
}